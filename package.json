{
  "name": "tc-bot",
  "version": "7.11.7",
  "description": "Ark of War Theorycrafter Bot",
  "keywords": [],
  "homepage": "https://github.com/ishark5060/tc-bot#readme",
  "bugs": {
    "url": "https://github.com/ishark5060/tc-bot/issues"
  },
  "license": "MIT",
  "author": "Shark5060",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishark5060/tc-bot.git"
  },
  "type": "module",
  "main": "dist/tc-bot.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/tc-bot.js",
    "deploy": "tsx src/deployCommands.ts",
    "lint": "oxlint --node-plugin --promise-plugin --import-plugin --vitest-plugin .",
    "format": "oxfmt --write .",
    "check-format": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "node run-quality-checks.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.24.0",
    "@googleapis/sheets": "^17.0.0",
    "@pm2/io": "^6.1.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
